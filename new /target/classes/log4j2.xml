<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">
    <Properties>
        <Property name="log-path">/opt/Programs/WildFly/8.2.0/standalone/log</Property>
    </Properties>
    
    
    <Appenders>
    
        <Console name="console-log" target="SYSTEM_OUT">
            <PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c (%13F:%L) - %msg%n"/>
        </Console>
        
        <RollingFile name="trace-log" fileName="${log-path}/log4jschool-trace.log"
                     filePattern="${log-path}/log4jschool-trace-%d{yyyy-MM-dd}.log">
            <PatternLayout>
                <pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c (%13F:%L) - %msg%n</pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
        
        <RollingFile name="info-log" fileName="${log-path}/log4jschool-info.log"
                     filePattern="${log-path}/log4jschool-info-%d{yyyy-MM-dd}.log">
            <PatternLayout>
                <pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c (%13F:%L) - %msg%n</pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
        
        <RollingFile name="error-log" fileName="${log-path}/log4jschool-error.log"
                     filePattern="${log-path}/log4jschool-error-%d{yyyy-MM-dd}.log">
            <PatternLayout>
                <pattern>[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c (%13F:%L) - %msg%n</pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
        
    </Appenders>
    
    
    <Loggers>
    
    	<!-- 
	    	Example of logging specific to a Java package
	        <Logger name="somepackage" level="debug" additivity="false">
	            <appender-ref ref="trace-log" level="debug"/>
	            <appender-ref ref="error-log" level="error"/>
	            <appender-ref ref="console-log" level="debug"/>
	        </Logger>
        -->
        
        <Root level="info" additivity="false">
            <AppenderRef ref="console-log" />            
            <appender-ref ref="info-log" level="info" />
            <appender-ref ref="error-log" level="error" />
        </Root>
        
    </Loggers>
    
    
</Configuration>