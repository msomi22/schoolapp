<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">



<hibernate-configuration>
	<session-factory>
	    <!-- SQL dialect -->
		<property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
		<!-- Connection settings -->
		<property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
		<property name="hibernate.connection.provider_class">com.zaxxer.hikari.hibernate.HikariConnectionProvider</property>
		<property name="hibernate.connection.username">school</property>
		<property name="hibernate.connection.password">AllaManO1</property>
		<property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/schooldb</property>

		<property name="connection_pool_size">2</property>
		<property name="statement_cache.size">2</property>
		
		<!-- Echo all executed SQL to stdout -->
		<property name="show_sql">false</property>
		
		<property name="use_outer_join">true</property>

		<!-- Drop and re-create all database on startup -->
		<!-- <property name="hibernate.hbm2ddl.auto">create-drop</property>  -->
		
		<!-- Enable Hibernate's automatic session context management -->
		<property name="current_session_context_class">thread</property>


		<!-- Add 2nd Level Cache including query caching -->
		<property name="hibernate.cache.use_second_level_cache">true</property>
		<property name="hibernate.cache.region.factory_class">org.hibernate.cache.ehcache.EhCacheRegionFactory</property>
		<property name="hibernate.cache.use_query_cache">true</property>
		<property name="org.ehcache.configurationResourceName">/ehcache.xml</property>


		<!-- Mapped classes -->
		<mapping class="com.yahoo.petermwenda83.bean.account.Account" />
		<mapping class="com.yahoo.petermwenda83.bean.account.OutGoingSMS" />
		<mapping class="com.yahoo.petermwenda83.bean.account.SmsApi" />

	</session-factory>
</hibernate-configuration>
